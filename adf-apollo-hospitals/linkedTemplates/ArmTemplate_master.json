{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-apollo-hospitals"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://apollohospitalsstorage.dfs.core.windows.net/"
		},
		"ls_azure_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "apollohospitals.database.windows.net"
		},
		"ls_azure_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-apollo"
		},
		"ls_azure_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "jibonchy"
		},
		"ls_key_vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://apollo-keyvault.vault.azure.net/"
		},
		"ls_postgreSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-bold-water-b3zwi8ib-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"ls_postgreSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgreSQL_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-apollo-hospitals_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_key_vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_key_vault_properties_typeProperties_baseUrl')]"
					},
					"ls_azure_db_properties_typeProperties_server": {
						"value": "[parameters('ls_azure_db_properties_typeProperties_server')]"
					},
					"ls_azure_db_properties_typeProperties_database": {
						"value": "[parameters('ls_azure_db_properties_typeProperties_database')]"
					},
					"ls_azure_db_properties_typeProperties_userName": {
						"value": "[parameters('ls_azure_db_properties_typeProperties_userName')]"
					},
					"ls_postgreSQL_properties_typeProperties_server": {
						"value": "[parameters('ls_postgreSQL_properties_typeProperties_server')]"
					},
					"ls_postgreSQL_properties_typeProperties_database": {
						"value": "[parameters('ls_postgreSQL_properties_typeProperties_database')]"
					},
					"ls_postgreSQL_properties_typeProperties_username": {
						"value": "[parameters('ls_postgreSQL_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}