{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-apollo-hospitals"
		},
		"ls_adb_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1009-141402-xrny5e3m"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://apollohospitalsstorage.dfs.core.windows.net/"
		},
		"ls_azure_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "apollohospitals.database.windows.net"
		},
		"ls_azure_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-apollo"
		},
		"ls_azure_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "jibonchy"
		},
		"ls_key_vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://apollo-keyvault.vault.azure.net/"
		},
		"ls_postgreSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-bold-water-b3zwi8ib-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"ls_postgreSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgreSQL_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pipeline1')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy data1",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": "SELECT * FROM PUBLIC.hospitals",
								"queryTimeout": "02:00:00"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_postgresSQL",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_landing_prq_sink",
								"type": "DatasetReference",
								"parameters": {
									"para_container": "landing",
									"para_folder": "test"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_postgresSQL')]",
				"[concat(variables('factoryId'), '/datasets/ds_landing_prq_sink')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_src_to_silver_inner')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "read table details",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT * FROM ctrl.table_config WHERE table_id = '@{pipeline().parameters.para_table_id}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_azureSQL",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "Set variable time",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "start_time",
							"value": {
								"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd_hh:mm:ss')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Source to Landing Ingestion",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "check load type",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": {
									"value": "SELECT * FROM PUBLIC.@{activity('read table details').output.firstRow.source_table_name}\n\n@{\n    if(equals(activity('read table details').output.firstRow.load_type, 'FULL')\n    ,'',\n    concat(\n        'where ' ,activity('read table details').output.firstRow.watermark_column ,'>', '''',variables('watermark_value'), ''''\n    )\n    )\n}\n",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_postgresSQL",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_landing_prq_sink",
								"type": "DatasetReference",
								"parameters": {
									"para_container": "landing",
									"para_folder": {
										"value": "@concat(\n    activity('read table details').output.firstRow.source_system,\n    '/',\n    activity('read table details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
										"type": "Expression"
									}
								}
							}
						]
					},
					{
						"name": "landing to bronze",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Source to Landing Ingestion",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/apollo-hospitals-repo/adb-apollo-hospitals-repo/landing_to_bronze",
							"baseParameters": {
								"source_system": {
									"value": "@activity('read table details').output.firstRow.source_system",
									"type": "Expression"
								},
								"table_name": {
									"value": "@activity('read table details').output.firstRow.bronze_table_name",
									"type": "Expression"
								},
								"landing_timestamp": {
									"value": "@variables('start_time')",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "ls_adb",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "bronze to silver",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "landing to bronze",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/apollo-hospitals-repo/adb-apollo-hospitals-repo/bronze_to_silver",
							"baseParameters": {
								"table_name": {
									"value": "@activity('read table details').output.firstRow.silver_table_name",
									"type": "Expression"
								},
								"landing_timestamp": {
									"value": "@variables('start_time')",
									"type": "Expression"
								},
								"merge_keys": {
									"value": "@coalesce(activity('read table details').output.firstRow.load_type, '')",
									"type": "Expression"
								},
								"load_type": {
									"value": "@activity('read table details').output.firstRow.load_type",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "ls_adb",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "update faild status",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "bronze to silver",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "ls_azure_db",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "\nUPDATE ctrl.audit_log\nSET status ='SUCCESS', end_time= SYSUTCDATETIME(), records_written= @{activity('bronze to silver').output.runOutput}\nWHERE adf_run_id = '@{pipeline().parameters.para_adf_run_id}' and table_id= @{pipeline().parameters.para_table_id}",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "check load type",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "read table details",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Set variable time",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(activity('read table details').output.firstRow.load_type ,'Full'))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "read watermark",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "SELECT watermark_value FROM ctrl.watermark WHERE table_id = @{pipeline().parameters.para_table_id}",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "ds_azureSQL",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "store watermark value",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "read watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "watermark_value",
										"value": {
											"value": "@activity('read watermark').output.firstRow.watermark_value",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "checking load type and updete watermark",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "bronze to silver",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(activity('read table details').output.firstRow.load_type ,'Full'))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "update watermark",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "ls_azure_db",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "UPDATE ctrl.watermark\nSET watermark_value = SYSUTCDATETIME()\nWHERE table_id = @{pipeline().parameters.para_table_id}",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"para_table_id": {
						"type": "string",
						"defaultValue": "1"
					},
					"para_adf_run_id": {
						"type": "string",
						"defaultValue": "a1"
					}
				},
				"variables": {
					"set_time": {
						"type": "String"
					},
					"start_time": {
						"type": "String"
					},
					"watermark_value": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_azureSQL')]",
				"[concat(variables('factoryId'), '/datasets/ds_postgresSQL')]",
				"[concat(variables('factoryId'), '/datasets/ds_landing_prq_sink')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_adb')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_azure_db')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_src_to_silver_main')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "read_src_table_list",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT table_id FROM ctrl.table_config WHERE is_active = 1 AND source_system = '@{pipeline().parameters.para_source_system}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_azureSQL",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ingest_all_table",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "read_src_table_list",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('read_src_table_list').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "ingest source to silver",
									"type": "ExecutePipeline",
									"dependsOn": [
										{
											"activity": "Insert in progress status",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "pl_src_to_silver_inner",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"para_table_id": {
												"value": "@item().table_id",
												"type": "Expression"
											},
											"para_adf_run_id": {
												"value": "@pipeline().parameters.para_adf_run_id",
												"type": "Expression"
											}
										}
									}
								},
								{
									"name": "Insert in progress status",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "ls_azure_db",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "INSERT INTO ctrl.audit_log (adf_run_id, table_id, stage, status, start_time)\nVALUES('@{pipeline().parameters.para_adf_run_id}', @{item().table_id}, 'SOURCE_TO_SILVER', 'IN_PROGRESS', SYSUTCDATETIME())",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "update faild status",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "ingest source to silver",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "ls_azure_db",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "\nUPDATE ctrl.audit_log\nSET status ='FAILED', end_time= SYSUTCDATETIME()\nWHERE adf_run_id = '@{pipeline().parameters.para_adf_run_id}' and table_id= @{item().table_id}",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"para_source_system": {
						"type": "string",
						"defaultValue": "neon_postgres"
					},
					"para_adf_run_id": {
						"type": "string",
						"defaultValue": "a4"
					}
				},
				"variables": {
					"test": {
						"type": "String"
					},
					"table_id": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_azureSQL')]",
				"[concat(variables('factoryId'), '/pipelines/pl_src_to_silver_inner')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_azure_db')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_azureSQL')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_azure_db",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_azure_db')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_landing_prq_sink')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"para_container": {
						"type": "string"
					},
					"para_folder": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
